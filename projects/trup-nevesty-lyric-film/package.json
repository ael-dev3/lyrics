{
  "name": "trup-nevesty-lyric-film",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/player.ts --bundle --format=esm --outfile=review/client.js",
    "preview": "npm run build && node scripts/preview-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "features": "node scripts/analyze-audio.ts",
    "proof": "node scripts/proof-scene.ts",
    "render:gate": "node scripts/render-gate.ts",
    "identity": "node scripts/refresh-identity.ts",
    "prepare:timeline": "node scripts/build-timeline.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "@napi-rs/canvas": "1.0.10"
  }
}
