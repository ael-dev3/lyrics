{
  "name": "tanisea-lyric-film",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build:tools": "tsc --project tsconfig.tools.json",
    "features": "npm run build:tools && node .tools-dist/scripts/generate-audio-features.js",
    "encode": "npm run build:tools && node .tools-dist/scripts/encode-delivery.js",
    "platform": "npm run build:tools && node .tools-dist/scripts/make-platform-delivery.js",
    "verify": "npm run build:tools && node .tools-dist/scripts/verify-delivery.js",
    "alignment:prepare": "npm run build:tools && node .tools-dist/scripts/prepare-alignment.js",
    "alignment:import": "npm run build:tools && node .tools-dist/scripts/import-alignment-evidence.js",
    "alignment:verify": "npm run build:tools && node .tools-dist/scripts/verify-alignment.js",
    "test": "vitest",
    "test:run": "vitest run",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:run && npm run compositions",
    "still": "remotion still src/index.ts LyricFilmVNext",
    "prerender": "npm run typecheck",
    "render": "remotion render src/index.ts LyricFilmVNext output/Tanisea-Lyric-Film-vNext-reference-2x.mov --scale=2 --codec=prores --prores-profile=4444 --pixel-format=yuv444p10le --image-format=png --color-space=bt709 --concurrency=8 --muted"
  },
  "dependencies": {
    "@remotion/cli": "4.0.518",
    "@remotion/media": "4.0.518",
    "@remotion/media-utils": "4.0.518",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
