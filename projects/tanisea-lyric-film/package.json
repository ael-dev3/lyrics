{
  "name": "tanisea-lyric-film",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run compositions",
    "still": "remotion still src/index.ts LyricFilm",
    "prerender": "npm run typecheck",
    "render": "remotion render src/index.ts LyricFilm output/Tanisea-Lyric-Film.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/cli": "4.0.518",
    "@remotion/media": "4.0.518",
    "@remotion/media-utils": "4.0.518",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2"
  }
}
