  "schemaVersion": 1,
  "sourceSha256": "93084f293d491da1519732f3fa3cf6416c783d04e8ca18b5569c7608a8d4540d",
  "lines": [
    {"id":"C1-01","text":"А я сотру горизонт"},
    {"id":"C1-02","text":"И разобью пополам"},
    {"id":"C1-03","text":"Сверну вершины всех гор"},
    {"id":"C1-04","text":"И подниму океан"},
    {"id":"C1-05","text":"Я закричу на весь мир"},
    {"id":"C1-06","text":"Пусть содрогнётся земля"},
    {"id":"C1-07","text":"И через стены квартир"},
    {"id":"C1-08","text":"Пройдусь волною огня"},
    {"id":"V1-01","text":"Ночь в тишине застывает безвольно"},
    {"id":"V1-02","text":"Небо провисло немым потолком"},
    {"id":"V1-03","text":"Помню, что было и гложут вопросы"},
    {"id":"V1-04","text":"Кто я? откуда? и где же мой дом"},
    {"id":"V1-05","text":"Сущность моя проходила по краю"},
    {"id":"V1-06","text":"Руки дрожали от тяжести лет"},
    {"id":"V1-07","text":"Одни говорили, другие молчали"},
    {"id":"V1-08","text":"А кто за спиною не сдерживал смех"},
    {"id":"C2-01","text":"А я сотру горизонт"},
    {"id":"C2-02","text":"И разобью пополам"},
    {"id":"C2-03","text":"Сверну вершины всех гор"},
    {"id":"C2-04","text":"И подниму океан"},
    {"id":"C2-05","text":"Я закричу на весь мир"},
    {"id":"C2-06","text":"Пусть содрогнётся земля"},
    {"id":"C2-07","text":"И через стены квартир"},
    {"id":"C2-08","text":"Пройдусь волною огня"}
  ]
}
