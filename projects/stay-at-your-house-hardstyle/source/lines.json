[
  {
    "id": "SH-001",
    "section": "Verse 1",
    "start": 0,
    "end": 5,
    "text": "I couldn't wait for you to come and clear the cupboards"
  },
  {
    "id": "SH-002",
    "section": "Verse 1",
    "start": 5,
    "end": 11,
    "text": "But now you're gone and leaving nothing but a sign"
  },
  {
    "id": "SH-003",
    "section": "Verse 1",
    "start": 11,
    "end": 19.9,
    "text": "Another evening, I'll be sitting reading in-between your lines"
  },
  {
    "id": "SH-004",
    "section": "Verse 1",
    "start": 19.9,
    "end": 23.3,
    "text": "Because I miss you all the time"
  },
  {
    "id": "SH-005",
    "section": "Pre-chorus",
    "start": 24.6,
    "end": 27,
    "text": "So, get away"
  },
  {
    "id": "SH-006",
    "section": "Pre-chorus",
    "start": 27,
    "end": 30.82,
    "text": "Another way to feel what you didn't want yourself to know"
  },
  {
    "id": "SH-007",
    "section": "Pre-chorus",
    "start": 30.82,
    "end": 32.6,
    "text": "And let yourself go"
  },
  {
    "id": "SH-008",
    "section": "Pre-chorus",
    "start": 32.6,
    "end": 36.3,
    "text": "You know you didn't lose your self-control"
  },
  {
    "id": "SH-009",
    "section": "Pre-chorus",
    "start": 36.3,
    "end": 38.85,
    "text": "Let's start at the rainbow"
  },
  {
    "id": "SH-010",
    "section": "Pre-chorus",
    "start": 38.85,
    "end": 40,
    "text": "Turn away"
  },
  {
    "id": "SH-011",
    "section": "Pre-chorus",
    "start": 40,
    "end": 43.8,
    "text": "Another way to be where you didn't want yourself to go"
  },
  {
