{
  "name": "girl-in-red-midnight-love-lyric-film",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "features": "node scripts/analyze.ts && node scripts/motion.ts",
    "render": "node scripts/render.ts",
    "verify": "node scripts/verify.ts",
    "alignment:verify": "node scripts/check.ts",
    "check": "npm run typecheck && npm run compositions && node scripts/check.ts && node scripts/dsp-test.ts && node scripts/layout.ts",
