[
  {
    "id": "KB-001",
    "start": 18.220424107142858,
    "end": 22.9515625,
    "text": "Каждый, кто сделал тебе больно покойник"
  },
  {
    "id": "KB-002",
    "start": 22.401590401785715,
    "end": 27.232756696428574,
    "text": "Укрою тебя пледом, посажу на подоконник"
  },
  {
    "id": "KB-003",
    "start": 26.662779017857144,
    "end": 31.513950892857146,
    "text": "Залезу под свитер, в самое сердце"
  },
  {
    "id": "KB-004",
    "start": 31.304073660714284,
    "end": 35.91517857142858,
    "text": "Ты холодный Питер, но в тебе можно согреться"
  },
  {
    "id": "KB-005",
    "start": 35.66529017857143,
    "end": 40.27639508928572,
    "text": "Каждый шрамом на запястье остался"
  },
  {
    "id": "KB-006",
    "start": 40.04651227678572,
    "end": 44.617606026785715,
    "text": "Я убью всех тех, кто посмел тебя касаться"
  },
  {
    "id": "KB-007",
    "start": 44.38772321428572,
    "end": 48.578710937500006,
    "text": "Мятые простыни, отключили свет"
  },
  {
    "id": "KB-008",
    "start": 48.46886160714286,
    "end": 52.99994419642858,
    "text": "Мы друг для друга созданы, бракованный дуэт"
  },
  {
    "id": "KB-009",
    "start": 53.070162133891216,
    "end": 57.161061715481175,
    "text": "Чай на столе, жаль, что не ты"
  },
  {
    "id": "KB-010",
    "start": 56.87115585774059,
    "end": 61.54220711297071,
    "text": "Привяжу тебя к себе, чтоб не боялась темноты"
  },
  {
    "id": "KB-011",
    "start": 61.79244246861925,
    "end": 66.20342573221757,
    "text": "Чай на столе, жаль, что не ты…"
  },
  {
    "id": "KB-012",
    "start": 70.49471757322176,
    "end": 74.62562761506275,
    "text": "Чай на столе, жаль, что не ты"
  },
  {
    "id": "KB-013",
    "start": 74.33572175732218,
    "end": 78.96676255230125,
    "text": "Привяжу тебя к себе, чтоб не боялась темноты"
  },
  {
    "id": "KB-014",
    "start": 79.21699790794979,
    "end": 83.64798640167363,
    "text": "Чай на столе, жаль, что не ты…"
  },
  {
    "id": "KB-015",
    "start": 105.36166842661035,
    "end": 109.83368532206968,
    "text": "Я бы хотела стать твоим одеялом"
  },
  {
    "id": "KB-016",
    "start": 109.24371700105597,
    "end": 114.19598732840548,
    "text": "Чтобы ночью ты со мной спала и не замерзала"
  },
  {
    "id": "KB-017",
    "start": 113.92618796198522,
    "end": 118.59831045406547,
    "text": "Согреть тебя тем, что от меня осталось"
  },
  {
    "id": "KB-018",
    "start": 118.04836325237592,
    "end": 123.12069693769799,
    "text": "Лишь бы ты не заболела, лишь бы утром улыбалась"
  },
  {
    "id": "KB-019",
    "start": 122.95095036958817,
    "end": 127.26288278775078,
    "text": "Я бы хотела жить с тобой в одном теле"
  },
  {
    "id": "KB-020",
    "start": 126.85300950369589,
    "end": 131.74524815205913,
    "text": "Игнорировать соседей, что стучат по батареям"
  },
  {
    "id": "KB-021",
    "start": 131.5755015839493,
    "end": 136.00749736008447,
    "text": "Днём или ночью это неважно"
  },
  {
    "id": "KB-022",
    "start": 135.4975712777191,
    "end": 140.48986272439282,
    "text": "Я так счастлива с тобой в этой большой многоэтажке"
  },
  {
    "id": "KB-023",
    "start": 140.3603058510638,
    "end": 144.43257978723403,
    "text": "Чай на столе, жаль, что не ты"
  },
  {
    "id": "KB-024",
    "start": 144.18284574468083,
    "end": 148.81549202127658,
    "text": "Привяжу тебя к себе, чтоб не боялась темноты"
  },
  {
    "id": "KB-025",
    "start": 149.08610372340422,
    "end": 153.51861702127658,
    "text": "Чай на столе, жаль, что не ты…"
  },
  {
