[
  {
    "id": "L01",
    "text": "Я помню как открыл глаза",
    "start": 2.310610847814639,
    "end": 7.062717219589258
  },
  {
    "id": "L02",
    "text": "И встретил в них тебя",
    "start": 7.133149025803055,
    "end": 10.864718272775146
  },
  {
    "id": "L03",
    "text": "Как первый луч, как тихий звон",
    "start": 11.6355186940495,
    "end": 16.887888362295946
  },
  {
    "id": "L04",
    "text": "Как первая гроза",
    "start": 16.81824644549763,
    "end": 20.729910479199578
  },
  {
    "id": "L05",
    "text": "Ты словно в небесах заря,",
    "start": 21.120510795155344,
    "end": 25.73254344391785
  },
  {
    "id": "L06",
    "text": "Ты полная Луна",
    "start": 25.582859399684043,
    "end": 29.01427066877304
  },
  {
    "id": "L07",
    "text": "Я помню лишь твои глаза,",
    "start": 29.925144813059504,
    "end": 34.317061611374406
  },
  {
    "id": "L08",
    "text": "А дальше пустота",
    "start": 34.28744075829384,
    "end": 37.678830963665085
  },
  {
    "id": "L09",
    "text": "Сотни ночных дорог напомнят мне тебя",
    "start": 40.971055684454754,
    "end": 48.264849187935035
  },
  {
    "id": "L10",
    "text": "Я в них терял свою любовь, и заново встречал",
    "start": 48.89564965197216,
    "end": 57.00991879350348
  },
  {
    "id": "L11",
    "text": "Лишь дай мне посмотреть в последний раз в твои глаза",
    "start": 57.36055684454757,
    "end": 65.09460556844549
  },
  {
    "id": "L12",
    "text": "Я потерял дорогу к ним, я потерял себя",
    "start": 65.8054524361949,
    "end": 73.51948955916474
  },
  {
    "id": "L13",
    "text": "И стук колёс как эшафот",
    "start": 76.37149122807018,
    "end": 81.18371710526316
  },
  {
    "id": "L14",
    "text": "Уносит тебя в даль",
    "start": 80.8139254385965,
    "end": 84.42549342105264
  },
  {
    "id": "L15",
    "text": "Я выберусь, моя любовь",
    "start": 84.71606359649124,
    "end": 89.66836622807018
  },
  {
    "id": "L16",
    "text": "Тебе я в след кричал",
    "start": 89.13848684210527,
    "end": 92.8701206140351
  },
  {
    "id": "L17",
    "text": "Я научусь тебя любить,",
    "start": 93.08064692982457,
    "end": 98.01293859649124
  },
  {
    "id": "L18",
    "text": "Мне без тебя не жить",
    "start": 97.56310307017544,
    "end": 101.43481359649124
  },
  {
    "id": "L19",
    "text": "Твой голос мой ориентир,",
    "start": 101.46524122807018,
    "end": 106.39753289473686
  },
  {
    "id": "L20",
    "text": "Я сам себя казнил",
    "start": 106.0077302631579,
    "end": 109.77938596491228
  },
  {
    "id": "L21",
    "text": "Сотни ночных дорог напомнят мне тебя",
    "start": 110.4701958384333,
    "end": 117.74418604651163
  },
  {
    "id": "L22",
    "text": "Я в них терял свою любовь, и заново встречал",
    "start": 118.3750305997552,
    "end": 126.58959608323134
  },
  {
    "id": "L23",
    "text": "Лишь дай мне посмотреть в последний раз в твои глаза",
    "start": 126.84020807833538,
    "end": 134.53445532435742
  },
  {
    "id": "L24",
    "text": "Я потерял дорогу к ним, я потерял себя",
    "start": 135.28537331701347,
    "end": 142.99963280293758
  },
  {
    "id": "L25",
    "text": "Лишь дай мне посмотреть в последний раз в твои глаза",
    "start": 143.67089715536105,
    "end": 151.44857768052515
  },
  {
    "id": "L26",
    "text": "Я солнцем обернусь и в них останусь навсегда",
    "start": 152.18019693654267,
    "end": 160.2381838074398
  }
]