[
  {
    "id": "VE-001",
    "start": 27.80192564346997,
    "end": 29.723164918970447,
    "text": "Разноцветные глаза"
  },
  {
    "id": "VE-002",
    "start": 29.383431839847475,
    "end": 31.32469018112488,
    "text": "Волосы цвета огня"
  },
  {
    "id": "VE-003",
    "start": 30.924899904671115,
    "end": 32.886177311725454,
    "text": "Пару личностей во мне"
  },
  {
    "id": "VE-004",
    "start": 32.48638703527169,
    "end": 34.68789323164919,
    "text": "Будь поосторожней"
  },
  {
    "id": "VE-005",
    "start": 34.08791229742612,
    "end": 35.98913250714967,
    "text": "Искупи свои грехи"
  },
  {
    "id": "VE-006",
    "start": 35.54930409914204,
    "end": 37.55061963775024,
    "text": "Мы священные огни"
  },
  {
    "id": "VE-007",
    "start": 37.11079122974262,
    "end": 38.691706387035275,
    "text": "Мы не так плохи"
  },
  {
    "id": "VE-008",
    "start": 38.07170638703528,
    "end": 40.51344137273594,
    "text": "Как ты думаешь"
  },
  {
    "id": "VE-009",
    "start": 40.293822688274545,
    "end": 42.27511916110581,
    "text": "Подойди ко мне на шаг"
  },
  {
    "id": "VE-010",
    "start": 41.85530981887512,
    "end": 44.03679694947569,
    "text": "Подними свой белый флаг"
  },
  {
    "id": "VE-011",
    "start": 43.47685414680649,
    "end": 45.27797902764538,
    "text": "Искусаю до крови"
  },
  {
    "id": "VE-012",
    "start": 44.738055290753096,
    "end": 46.879504289799804,
    "text": "Пощады не проси"
  },
  {
    "id": "VE-013",
    "start": 65.1820618556701,
    "end": 67.14403534609721,
    "text": "Растворившись в тишине"
  },
  {
    "id": "VE-014",
    "start": 66.80444771723123,
    "end": 68.72636229749632,
    "text": "Голос твой на глубине"
  },
  {
    "id": "VE-015",
    "start": 68.32668630338733,
    "end": 70.26863033873343,
    "text": "Тайну расскажет реке"
  },
  {
    "id": "VE-016",
    "start": 71.47131075110457,
    "end": 73.49337260677467,
    "text": "Я кажусь тебе другой"
  },
  {
    "id": "VE-017",
    "start": 72.97351988217967,
    "end": 74.95552282768779,
    "text": "Хочешь, получи любовь"
  },
  {
    "id": "VE-018",
    "start": 74.5758762886598,
    "end": 77.85979381443299,
    "text": "Но не забывай, что это дар не мой"
  },
  {
    "id": "VE-019",
    "start": 77.68114613180516,
    "end": 81.12922636103153,
    "text": "Не стоило смотреть в мои глаза"
  },
  {
    "id": "VE-020",
    "start": 80.64962750716333,
    "end": 84.9,
    "text": "И не утони потом в своих слезах"
  },
  {
    "id": "VE-021",
    "start": 90.1626895565093,
    "end": 92.84563662374822,
    "text": "На ветру белое платье"
  },
  {
    "id": "VE-022",
    "start": 92.48600858369099,
    "end": 94.38783977110158,
    "text": "На тебе проклятье"
  },
  {
    "id": "VE-023",
    "start": 93.98815450643777,
    "end": 96.95150214592275,
    "text": "Мне нужны объятия, поцелуи, счастье"
  },
  {
    "id": "VE-024",
    "start": 96.4316452074392,
    "end": 99.07453505007153,
    "text": "Разлетелся пепел боли"
  },
  {
    "id": "VE-025",
    "start": 98.77499284692418,
    "end": 100.55665236051503,
    "text": "Я бегу по полю"
  },
  {
    "id": "VE-026",
    "start": 100.05682403433477,
    "end": 101.77839771101574,
    "text": "С тобою в небеса"
  },
  {
    "id": "VE-027",
    "start": 108.86226037195995,
    "end": 110.8442060085837,
    "text": "Мы с тобой как волшебство"
  },
  {
    "id": "VE-028",
    "start": 110.40446351931331,
    "end": 112.32632331902718,
    "text": "Жаль, в конце ждёт ничего"
  },
  {
    "id": "VE-029",
    "start": 112.0868669527897,
    "end": 114.12889842632333,
    "text": "Я не знаю как нам быть"
  },
  {
    "id": "VE-030",
    "start": 113.58901287553648,
    "end": 115.53090128755366,
    "text": "Будет проще отпустить"
  },
  {
    "id": "VE-031",
    "start": 114.95095851216023,
    "end": 117.17324749642347,
    "text": "Мне казалось ты любил"
  },
  {
    "id": "VE-032",
    "start": 116.63336194563662,
    "end": 118.71545064377683,
    "text": "Но в глаза кидал мне пыль"
  },
  {
    "id": "VE-033",
    "start": 118.15553648068669,
    "end": 120.35779685264664,
    "text": "Книга жизни возгорит"
  },
  {
    "id": "VE-034",
    "start": 119.79788268955652,
    "end": 121.9,
    "text": "Больше не найдёшь страниц"
  },
  {
    "id": "VE-035",
    "start": 121.36050847457628,
    "end": 124.8084745762712,
    "text": "Не стоило смотреть в мои глаза"
  },
  {
    "id": "VE-036",
    "start": 124.32887005649718,
    "end": 128.9,
    "text": "И не утони потом в своих слезах"
  },
  {
    "id": "VE-037",
    "start": 133.80460732984292,
    "end": 136.50732984293194,
    "text": "На ветру белое платье"
  },
  {
    "id": "VE-038",
