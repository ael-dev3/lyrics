      "kind": "lyric_reference"
    },
    {
      "id": 53,
      "start": 173.777,
      "end": 175.452,
      "text": "when the feed moves on.",
      "kind": "lyric_reference"
    },
    {
      "id": 54,
      "start": 175.452,
      "end": 175.452,
      "text": "[Bridge \u2014 stripped beat, almost conversational singing]",
      "kind": "section_hint"
    },
    {
      "id": 55,
      "start": 175.452,
      "end": 176.649,
      "text": "On Farcaster, I bought your song.",
      "kind": "lyric_reference"
    },
    {
      "id": 56,
      "start": 176.649,
      "end": 183.83,
      "text": "You said it kept the lights on.",
      "kind": "lyric_reference"
    },
    {
      "id": 57,
      "start": 183.83,
      "end": 185.745,
      "text": "A hundred little trades like that\u2014",
      "kind": "lyric_reference"
    },
    {
      "id": 58,
      "start": 185.745,
      "end": 187.899,
      "text": "a street where nothing stood before.",
      "kind": "lyric_reference"
    },
    {
      "id": 59,
      "start": 187.899,
      "end": 190.053,
      "text": "Let companies keep their signs.",
      "kind": "lyric_reference"
    },
    {
      "id": 60,
      "start": 190.053,
      "end": 192.367,
      "text": "We'll keep the names we answer to.",
      "kind": "lyric_reference"
    },
    {
      "id": 61,
      "start": 192.367,
      "end": 194.282,
      "text": "I don't need to own your world.",
      "kind": "lyric_reference"
    },
    {
      "id": 62,
      "start": 194.282,
      "end": 204.282,
      "text": "I need a way to get to you.",
      "kind": "lyric_reference"
    },
    {
      "id": 63,
      "start": 214.149,
      "end": 214.149,
