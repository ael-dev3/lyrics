{
  "status": "UNREVIEWED_EMBEDDED_REFERENCE_NOT_ACOUSTIC_ALIGNMENT",
  "cues": [
    {
      "id": 1,
      "start": 7.66,
      "end": 7.66,
      "text": "[Intro \u2014 close vocal, filtered pulse]",
      "kind": "section_hint"
    },
    {
      "id": 2,
      "start": 7.66,
      "end": 16.197,
      "text": "You still there?",
      "kind": "lyric_reference"
    },
    {
      "id": 3,
      "start": 16.197,
      "end": 24.495,
      "text": "Leave it on.",
      "kind": "lyric_reference"
    },
    {
      "id": 4,
      "start": 24.495,
      "end": 24.495,
      "text": "[Verse 1 \u2014 restrained, dry drums enter]",
      "kind": "section_hint"
    },
    {
      "id": 5,
      "start": 24.495,
      "end": 28.803,
      "text": "I found your name at half past two,",
      "kind": "lyric_reference"
    },
    {
      "id": 6,
      "start": 28.803,
      "end": 31.277,
      "text": "with half a world between our rooms.",
      "kind": "lyric_reference"
    },
    {
      "id": 7,
      "start": 31.277,
      "end": 37.42,
      "text": "We'd spent our days inside a feed",
      "kind": "lyric_reference"
    },
    {
      "id": 8,
      "start": 37.42,
      "end": 41.17,
      "text": "that had a price for everything.",
      "kind": "lyric_reference"
    },
    {
      "id": 9,
      "start": 41.17,
      "end": 45.399,
      "text": "You showed me where the river bends,",
      "kind": "lyric_reference"
    },
    {
      "id": 10,
      "start": 45.399,
      "end": 49.707,
      "text": "the timber stacked beside the wall.",
      "kind": "lyric_reference"
    },
    {
      "id": 11,
      "start": 49.707,
      "end": 53.936,
      "text": "There wasn't much to look at yet.",
      "kind": "lyric_reference"
    },
    {
      "id": 12,
      "start": 53.936,
      "end": 59.362,
      "text": "We stayed until the lamps came on.",
      "kind": "lyric_reference"
    },
    {
      "id": 13,
      "start": 59.362,
      "end": 59.362,
      "text": "[Pre-Chorus \u2014 bass opens, voice remains close]",
      "kind": "section_hint"
    },
    {
      "id": 14,
      "start": 59.362,
      "end": 61.516,
      "text": "You left a gap beside the gate.",
      "kind": "lyric_reference"
    },
    {
      "id": 15,
      "start": 61.516,
      "end": 63.75,
      "text": "I asked what you were saving for.",
      "kind": "lyric_reference"
    },
    {
      "id": 16,
      "start": 63.75,
      "end": 65.824,
      "text": "You said, \"We haven't met them yet,\"",
      "kind": "lyric_reference"
    },
    {
      "id": 17,
      "start": 65.824,
      "end": 69.33500000000001,
      "text": "and went on working in the rain.",
      "kind": "lyric_reference"
    },
    {
      "id": 18,
      "start": 69.33500000000001,
      "end": 69.33500000000001,
      "text": "[Chorus \u2014 wide melody, hard drums, no shouting]",
      "kind": "section_hint"
    },
    {
      "id": 19,
      "start": 69.33500000000001,
      "end": 71.41,
      "text": "Let them sell another future.",
      "kind": "lyric_reference"
    },
    {
      "id": 20,
      "start": 71.41,
      "end": 77.793,
      "text": "We're still working on this one.",
      "kind": "lyric_reference"
    },
    {
      "id": 21,
      "start": 77.793,
      "end": 79.947,
      "text": "There's a light across the water",
      "kind": "lyric_reference"
    },
    {
      "id": 22,
      "start": 79.947,
      "end": 84.73400000000001,
      "text": "and a door we haven't hung.",
      "kind": "lyric_reference"
    },
    {
      "id": 23,
      "start": 84.73400000000001,
      "end": 88.48400000000001,
      "text": "Something that stays",
      "kind": "lyric_reference"
    },
    {
      "id": 24,
      "start": 88.48400000000001,
      "end": 90.239,
      "text": "when the feed moves on.",
      "kind": "lyric_reference"
    },
    {
      "id": 25,
      "start": 90.239,
      "end": 90.798,
      "text": "Something that stays",
      "kind": "lyric_reference"
    },
    {
      "id": 26,
