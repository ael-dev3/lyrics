[
  {
    "id": "R2",
    "referenceIds": [
      2
    ],
    "start": 7.01,
    "end": 16.447,
    "text": "You still there?"
  },
  {
    "id": "R3",
    "referenceIds": [
      3
    ],
    "start": 15.546999999999999,
    "end": 24.745,
    "text": "Leave it on."
  },
  {
    "id": "R5",
    "referenceIds": [
      5
    ],
    "start": 23.845000000000002,
    "end": 29.053,
    "text": "I found your name at half past two,"
  },
  {
    "id": "R6",
    "referenceIds": [
      6
    ],
    "start": 28.153000000000002,
    "end": 31.527,
    "text": "with half a world between our rooms."
  },
  {
    "id": "R7",
    "referenceIds": [
      7
    ],
    "start": 30.627000000000002,
    "end": 37.67,
    "text": "We'd spent our days inside a feed"
  },
  {
    "id": "R8",
    "referenceIds": [
      8
    ],
    "start": 36.77,
    "end": 41.42,
    "text": "that had a price for everything."
  },
  {
    "id": "R9",
    "referenceIds": [
      9
    ],
    "start": 40.52,
    "end": 45.649,
    "text": "You showed me where the river bends,"
  },
  {
    "id": "R10",
    "referenceIds": [
      10
    ],
    "start": 44.749,
    "end": 49.957,
    "text": "the timber stacked beside the wall."
  },
  {
    "id": "R11",
    "referenceIds": [
      11
    ],
    "start": 49.057,
    "end": 54.186,
    "text": "There wasn't much to look at yet."
  },
  {
    "id": "R12",
    "referenceIds": [
      12
    ],
    "start": 53.286,
    "end": 59.612,
    "text": "We stayed until the lamps came on."
  },
  {
    "id": "R14",
    "referenceIds": [
      14
    ],
    "start": 58.712,
    "end": 61.766,
    "text": "You left a gap beside the gate."
  },
  {
    "id": "R15",
    "referenceIds": [
      15
    ],
    "start": 60.866,
    "end": 64.0,
    "text": "I asked what you were saving for."
  },
  {
    "id": "R16",
    "referenceIds": [
      16
    ],
    "start": 63.1,
    "end": 66.074,
    "text": "You said, \"We haven't met them yet,\""
  },
  {
    "id": "R17",
    "referenceIds": [
      17
    ],
    "start": 65.17399999999999,
    "end": 69.58500000000001,
    "text": "and went on working in the rain."
  },
  {
    "id": "R19",
    "referenceIds": [
      19
    ],
    "start": 68.685,
    "end": 71.66,
    "text": "Let them sell another future."
  },
  {
    "id": "R20",
    "referenceIds": [
      20
    ],
    "start": 70.75999999999999,
    "end": 78.043,
    "text": "We're still working on this one."
  },
  {
    "id": "R21",
    "referenceIds": [
      21
    ],
    "start": 77.143,
    "end": 80.197,
    "text": "There's a light across the water"
  },
  {
    "id": "R22",
    "referenceIds": [
      22
    ],
    "start": 79.297,
    "end": 84.98400000000001,
    "text": "and a door we haven't hung."
  },
  {
    "id": "R32",
    "referenceIds": [
      32
    ],
    "start": 102.35499999999999,
    "end": 106.686,
    "text": "Warpkeep Hyperion dreamed in stone,"
  },
  {
    "id": "R33",
    "referenceIds": [
      33
    ],
    "start": 105.786,
    "end": 110.91499999999999,
    "text": "the starways grown through root and rain."
  },
  {
    "id": "R34",
    "referenceIds": [
      34
    ],
    "start": 110.01499999999999,
    "end": 114.426,
    "text": "A river threads a thousand doors;"
  },
  {
    "id": "R35",
    "referenceIds": [
      35
    ],
    "start": 113.526,
    "end": 117.936,
    "text": "the old tombs let tomorrow in."
  },
  {
    "id": "R36",
    "referenceIds": [
      36,
      37
    ],
    "start": 117.036,
    "end": 127.75,
    "text": "The Core keeps dreaming underneath, where no one hears the turning gears."
  },
  {
    "id": "R38",
    "referenceIds": [
      38
    ],
    "start": 126.85,
    "end": 132.059,
    "text": "Above it, someone lights the forge."
  },
  {
    "id": "R39",
    "referenceIds": [
      39
    ],
    "start": 131.159,
    "end": 136.527,
    "text": "Above it, someone's waiting here."
  },
  {
    "id": "R41",
    "referenceIds": [
      41
    ],
    "start": 135.62699999999998,
    "end": 138.681,
    "text": "An empire is a distant thing."
  },
  {
    "id": "R42",
    "referenceIds": [
      42
    ],
    "start": 137.781,
    "end": 140.835,
    "text": "The work is close enough to touch."
  },
  {
    "id": "R43",
    "referenceIds": [
      43
    ],
    "start": 139.935,
    "end": 142.91,
    "text": "You put another beam in place."
  },
  {
    "id": "R44",
    "referenceIds": [
      44
    ],
    "start": 142.01,
    "end": 146.34,
    "text": "For once, that feels like enough."
  },
  {
    "id": "R46",
    "referenceIds": [
      46
    ],
    "start": 145.44,
    "end": 148.495,
    "text": "Let them sell another future."
  },
  {
    "id": "R47",
    "referenceIds": [
      47
    ],
    "start": 147.595,
    "end": 154.957,
    "text": "We're still working on this one."
  },
  {
    "id": "R48",
    "referenceIds": [
      48
    ],
    "start": 154.057,
    "end": 157.03199999999998,
    "text": "There's a light across the water"
  },
  {
    "id": "R49",
    "referenceIds": [
      49
    ],
    "start": 156.13199999999998,
    "end": 161.81900000000002,
    "text": "and a door we haven't hung."
  },
  {
    "id": "R50",
    "referenceIds": [
      50
    ],
    "start": 160.919,
    "end": 165.56900000000002,
    "text": "Something that stays"
  },
  {
    "id": "R51",
    "referenceIds": [
      51
    ],
    "start": 164.669,
    "end": 170.356,
    "text": "when the feed moves on."
  },
  {
    "id": "R52",
    "referenceIds": [
      52
    ],
    "start": 169.456,
    "end": 174.027,
    "text": "Something that stays"
  },
  {
    "id": "R53",
    "referenceIds": [
      53
    ],
    "start": 173.12699999999998,
    "end": 175.702,
    "text": "when the feed moves on."
  },
  {
    "id": "R55",
    "referenceIds": [
      55,
      56
    ],
    "start": 174.802,
    "end": 184.08,
    "text": "On Farcaster, I bought your song. You said it kept the lights on."
  },
  {
    "id": "R57",
    "referenceIds": [
      57
    ],
    "start": 183.18,
    "end": 185.995,
    "text": "A hundred little trades like that\u2014"
  },
  {
    "id": "R58",
    "referenceIds": [
      58
    ],
    "start": 185.095,
    "end": 188.149,
    "text": "a street where nothing stood before."
  },
  {
    "id": "R59",
    "referenceIds": [
      59
    ],
    "start": 187.249,
    "end": 190.303,
    "text": "Let companies keep their signs."
  },
  {
    "id": "R60",
    "referenceIds": [
      60
    ],
    "start": 189.403,
    "end": 192.617,
    "text": "We'll keep the names we answer to."
  },
  {
    "id": "R61",
    "referenceIds": [
      61
    ],
    "start": 191.71699999999998,
    "end": 194.532,
    "text": "I don't need to own your world."
  },
  {
    "id": "R62",
    "referenceIds": [
      62
    ],
    "start": 193.632,
    "end": 204.532,
    "text": "I need a way to get to you."
  },
  {
    "id": "R65",
    "referenceIds": [
      65
    ],
    "start": 213.499,
    "end": 216.473,
    "text": "Let them sell another future."
  },
  {
    "id": "R66",
    "referenceIds": [
      66
    ],
    "start": 215.573,
    "end": 222.936,
    "text": "We're still working on this one."
  },
  {
    "id": "R67",
    "referenceIds": [
      67
    ],
    "start": 222.036,
    "end": 225.09,
    "text": "There's a light across the water"
  },
  {
    "id": "R68",
    "referenceIds": [
      68
    ],
    "start": 224.19,
    "end": 229.878,
    "text": "and a door we've finally hung."
  },
  {
    "id": "R69",
    "referenceIds": [
      69
    ],
    "start": 228.97799999999998,
    "end": 233.628,
    "text": "Something that stays"
  },
  {
    "id": "R70",
    "referenceIds": [
      70
    ],
    "start": 232.72799999999998,
    "end": 238.415,
    "text": "when the feed moves on."
  },
  {
    "id": "R71",
    "referenceIds": [
      71
    ],
    "start": 237.515,
    "end": 239.612,
    "text": "Something that stays."
  },
  {
    "id": "R72",
    "referenceIds": [
      72
    ],
    "start": 238.712,
    "end": 246.872,
    "text": "I'm still here."
  },
  {
    "id": "R73",
    "referenceIds": [
      73
    ],
    "start": 245.972,
    "end": 255.09,
    "text": "Leave it on."
  },
  {
    "id": "R75",
    "referenceIds": [
      75
    ],
    "start": 254.19,
    "end": 259.319,
    "text": "The river runs."
  },
  {
    "id": "R76",
    "referenceIds": [
      76
    ],
    "start": 258.41900000000004,
    "end": 263.787,
    "text": "The window glows."
  },
  {
    "id": "R77",
    "referenceIds": [
      77
    ],
    "start": 262.887,
    "end": 268.016,
    "text": "You still there?"
  },
  {
    "id": "R78",
    "referenceIds": [
      78
    ],
    "start": 267.11600000000004,
    "end": 273.213,
    "text": "I'm still here."
  }
]
