[
  {
    "id": "LM-001",
    "start": 0.8,
    "end": 7,
    "text": "Непокорная моя любовь"
  },
  {
    "id": "LM-002",
    "start": 7.8,
    "end": 14.8,
    "text": "Любит не меня уже который год"
  },
  {
    "id": "LM-003",
    "start": 14.7,
    "end": 18.4,
    "text": "Те же стены и цветы"
  },
  {
    "id": "LM-004",
    "start": 18.3,
    "end": 21.8,
    "text": "Те же люди и стихи"
  },
  {
    "id": "LM-005",
    "start": 21.7,
    "end": 28,
    "text": "Те же мысли и слова вслух"
  },
  {
    "id": "LM-006",
    "start": 29,
    "end": 35.6,
    "text": "Люби меня, люби жарким огнём"
  },
  {
    "id": "LM-007",
    "start": 35.5,
    "end": 41.4,
    "text": "Ночью и днём, сердце сжигая"
  },
  {
    "id": "LM-008",
    "start": 41.4,
    "end": 47.6,
    "text": "Люби меня, люби, не улетай"
  },
  {
    "id": "LM-009",
    "start": 47.7,
    "end": 53.6,
    "text": "Не исчезай, я умоляю"
  },
  {
    "id": "LM-010",
    "start": 53.4,
    "end": 56.7,
    "text": "Люби меня, люби"
  },
