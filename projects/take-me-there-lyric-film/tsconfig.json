{
 "compilerOptions": {
   "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
   "strict": true, "noEmit": true, "skipLibCheck": true,
   "resolveJsonModule": true, "allowImportingTsExtensions": true,
   "verbatimModuleSyntax": true, "noUncheckedIndexedAccess": true,
   "exactOptionalPropertyTypes": true, "types": ["node"], "lib": ["ES2022", "DOM"]
 },
 "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
