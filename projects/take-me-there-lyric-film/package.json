{
  "name": "take-me-there-lyric-film",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/player.ts --bundle --format=esm --outfile=review/client.js",
    "preview": "npm run build && node scripts/preview-server.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node --test tests/*.test.ts && node scripts/check.ts",
    "features": "node scripts/analyze-audio.ts",
    "render:production": "node scripts/render-gate.ts"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "@napi-rs/canvas": "0.1.100"
  }
}
