  },
  {
    "id": "LL-12",
    "start": 101.1,
    "end": 106.2,
    "text": "Escale balnéaire, atmosphère bleu Neptune,"
  },
  {
    "id": "LL-13",
    "start": 107.3,
    "end": 113.1,
    "text": "Loin d’un souvenir solaire"
  },
  {
    "id": "LL-14",
